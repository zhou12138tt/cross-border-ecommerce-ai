# ===== 应用 =====
APP_NAME=跨境电商AI平台
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# ===== 数据库 =====
# Demo 默认使用 SQLite（零依赖）；如需切换 PostgreSQL：
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/cbe_ai
DATABASE_URL=sqlite:///./cbe_ai.db

# ===== 缓存 / 队列（Demo 可不启用）=====
REDIS_URL=redis://localhost:6379/0
CELERY_ENABLED=false

# ===== LLM（智能客服，Demo 用规则兜底，留空即可）=====
LLM_PROVIDER=mock
OPENAI_API_KEY=
QWEN_API_KEY=

# ===== 日志 =====
LOG_LEVEL=INFO
